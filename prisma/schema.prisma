generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  PROFESSOR
  STUDENT
  ADMIN
}

enum QuizSessionStatus {
  ACTIVE
  CLOSED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          Role
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  professor     ProfessorProfile?
  student       StudentProfile?
  quizSessions  QuizSession[]     @relation("QuizTeacher")
  assignmentsCreated Assignment[]  @relation("AssignmentCreator")
  assignmentAttempts AssignmentAttempt[] @relation("AssignmentAttemptStudent")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model ProfessorProfile {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id])
  isApproved Boolean       @default(false)
  subjects   Subject[]     @relation("ProfessorSubjects")
  levels     SchoolLevel[] @relation("ProfessorLevels")
}

model StudentProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  currentLevelId String?
  currentLevel   SchoolLevel? @relation(fields: [currentLevelId], references: [id])
}

model Subject {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  chapters         Chapter[]
  professorProfiles ProfessorProfile[] @relation("ProfessorSubjects")
}

model SchoolLevel {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  order             Int                @default(0)
  chapters          Chapter[]
  professorProfiles ProfessorProfile[] @relation("ProfessorLevels")
  students          StudentProfile[]
}

model Chapter {
  id        String      @id @default(cuid())
  slug      String
  title     String
  order     Int         @default(1)
  subjectId String
  levelId   String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  level     SchoolLevel @relation(fields: [levelId], references: [id])

  @@unique([subjectId, levelId, slug])
}

model QuizSession {
  id           String             @id @default(cuid())
  code         String             @unique
  teacherId    String
  teacher      User               @relation("QuizTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  chapterSlug  String
  status       QuizSessionStatus  @default(ACTIVE)
  createdAt    DateTime           @default(now())
  participants QuizParticipant[]
  questions    DynamicQuestion[]

  @@index([code])
  @@index([teacherId])
}

model QuizParticipant {
  id             String      @id @default(cuid())
  sessionId      String
  session        QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentName    String
  score          Int         @default(0)
  totalQuestions Int         @default(0)
  submitted      Boolean     @default(false)
  submittedAt    DateTime    @default(now())

  @@unique([sessionId, studentName])
  @@index([sessionId])
}

model DynamicQuestion {
  id                String       @id @default(cuid())
  sessionId         String?
  session           QuizSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chapterSlug       String
  questionText      String
  formula           String?
  options           Json
  correctOptionIndex Int
  variableParams    Json

  @@index([sessionId])
  @@index([chapterSlug])
}

model QuizQuestion {
  id                String     @id @default(cuid())
  chapterSlug       String
  title             String
  formula           String     @default("")
  options           Json
  correctOptionIndex Int
  difficulty        Difficulty @default(MEDIUM)
  isTemplate        Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@unique([chapterSlug, title])
  @@index([chapterSlug])
}

model Assignment {
  id           String           @id @default(cuid())
  accessCode   String           @unique
  title        String
  instructions String?
  subjectSlug  String
  levelSlug    String
  chapterSlug  String
  status       AssignmentStatus @default(DRAFT)
  createdById  String
  createdBy    User             @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  dueDate      DateTime?
  attemptLimit Int              @default(1)
  showFeedback Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  questions    AssignmentQuestion[]
  attempts     AssignmentAttempt[]

  @@index([createdById])
  @@index([status])
  @@index([subjectSlug])
  @@index([levelSlug])
  @@index([chapterSlug])
}

model AssignmentQuestion {
  id                String             @id @default(cuid())
  assignmentId      String
  assignment        Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  index             Int
  title             String
  formula           String?
  options           Json
  correctOptionIndex Int
  difficulty        Difficulty         @default(MEDIUM)
  points            Float              @default(1)
  sourceQuestionId  String?
  createdAt         DateTime           @default(now())
  answers           AssignmentAnswer[]

  @@unique([assignmentId, index])
  @@index([assignmentId])
}

model AssignmentAttempt {
  id             String                 @id @default(cuid())
  assignmentId   String
  assignment     Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User                   @relation("AssignmentAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  status         AssignmentAttemptStatus @default(IN_PROGRESS)
  score          Float?
  startedAt      DateTime               @default(now())
  submittedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  answers        AssignmentAnswer[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model AssignmentAnswer {
  id           String             @id @default(cuid())
  attemptId    String
  attempt      AssignmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}